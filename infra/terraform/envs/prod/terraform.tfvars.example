# Copy to terraform.tfvars (not committed) and fill in.
app_domain    = "app.example.in"
origin_domain = "origin.app.example.in"
email_domain  = "notify.example.in"
# Hosted zone for example.in in Route 53, or null to create DNS records by hand.
route53_zone_id = null
alert_emails    = ["ops@example.in"]
# sentry_dsn    = "https://<key>@o<org>.ingest.sentry.io/<project>"

# SaaS subscriptions (docs/mvp-2/subscriptions.md). Every value here is a placeholder:
# use Razorpay's keys and plans (test mode on staging) and the company's own GST details.
# The key secret and webhook secret go into Secrets Manager by hand, never here.
subscriptions = {
  razorpay_key_id = "rzp_live_XXXXXXXXXXXXXX"
  razorpay_plan_ids = {
    starter_monthly    = "plan_XXXXXXXXXXXXXX"
    starter_annual     = "plan_XXXXXXXXXXXXXX"
    standard_monthly   = "plan_XXXXXXXXXXXXXX"
    standard_annual    = "plan_XXXXXXXXXXXXXX"
    enterprise_monthly = "plan_XXXXXXXXXXXXXX"
    enterprise_annual  = "plan_XXXXXXXXXXXXXX"
  }
  platform = {
    legal_name = "<Company legal name> Private Limited"
    gstin      = "<15-character GSTIN>"
    address    = "<street line 1> | <street line 2>"
    city       = "<city>"
    pincode    = "<PIN>"
    email      = "billing@example.in"
  }
}
