{
  "name": "@paint/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API (NestJS).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@fastify/multipart": "^10.1.2",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@paint/db": "workspace:*",
    "@paint/observability": "workspace:*",
    "@paint/shared": "workspace:*",
    "@sentry/core": "^11.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.1",
    "@paint/testing": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "vite": "^8.3.1"
