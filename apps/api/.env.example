# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://paint:paint@localhost:55432/paint
LOG_LEVEL=log
RUN_MIGRATIONS=true
# Any random string of 32+ characters for local use. Production uses a secret from AWS Secrets Manager.
AUTH_SECRET=local-development-secret-change-me-0000
SESSION_TTL_DAYS=30
# "log" prints sign-in codes to the console (development only). Production: "disabled" until MSG91 is connected.
SMS_PROVIDER=log
