# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://paint:paint@localhost:55432/paint
LOG_LEVEL=log
RUN_MIGRATIONS=true
# Any random string of 32+ characters for local use. Production uses a secret from AWS Secrets Manager.
AUTH_SECRET=local-development-secret-change-me-0000
SESSION_TTL_DAYS=30
# "log" prints sign-in codes to the console (development only). Production: "disabled" until MSG91 is connected.
SMS_PROVIDER=log
# Documents: S3-compatible storage and ClamAV from compose.yaml. Production: Amazon S3 with the server's IAM role.
STORAGE_BUCKET=paint-documents
STORAGE_ENDPOINT=http://localhost:58333
STORAGE_ACCESS_KEY_ID=local
STORAGE_SECRET_ACCESS_KEY=local
CLAMAV_HOST=localhost
CLAMAV_PORT=53310
# Notification emails go to Mailpit from compose.yaml (http://localhost:58025). Production: Amazon SES SMTP.
APP_URL=http://localhost:5173
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:51025
EMAIL_FROM="Paint Retail <alerts@localhost>"
# The worker sends email and checks low stock this often.
WORKER_INTERVAL_SECONDS=10
# One-time secret to create the first platform operator (POST /platform/bootstrap); remove it afterwards.
# PLATFORM_BOOTSTRAP_TOKEN=change-me-to-a-long-random-secret-0000
# Plan for businesses that sign themselves up: trial, starter, standard or enterprise.
SIGNUP_PLAN=trial
# How subscriptions are collected: "manual" (the default: our invoices, paid by bank transfer or UPI
# and recorded by a platform operator), "razorpay", or "fake" (no money; its checkout is a page of the web app).
SUBSCRIPTION_GATEWAY=manual
# SUBSCRIPTION_TRIAL_DAYS=14
# SUBSCRIPTION_GRACE_DAYS=7
# With SUBSCRIPTION_GATEWAY=razorpay (test-mode keys locally; never commit them):
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_IDS={"starter_monthly":"plan_...","starter_annual":"plan_...","standard_monthly":"plan_...","standard_annual":"plan_...","enterprise_monthly":"plan_...","enterprise_annual":"plan_..."}
# The platform's own GST details on its invoices to businesses (placeholders when unset; required in production).
# PLATFORM_LEGAL_NAME=...
# PLATFORM_GSTIN=...
# PLATFORM_ADDRESS=line 1 | line 2
# PLATFORM_CITY=...
# PLATFORM_PINCODE=...
# Where businesses pay manual invoices (placeholders when unset; required in production with "manual").
# PLATFORM_BANK_NAME=HDFC Bank, Banjara Hills
# PLATFORM_BANK_ACCOUNT_NAME=...
# PLATFORM_BANK_ACCOUNT_NUMBER=...
# PLATFORM_BANK_IFSC=HDFC0000123
# PLATFORM_UPI_ID=name@bank
